<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LehmiaeJonossa.ViewModels"
        xmlns:models="using:LehmiaeJonossa.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="850"
        x:Class="LehmiaeJonossa.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Icon="/Assets/app-icon.ico"
        Title="LehmiaeJonossa"
        Width="1280" Height="860"
        MinWidth="960" MinHeight="650"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <Window.Styles>
        <!-- Common Style Rules -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
        </Style>

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThemeCardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ThemeCardCornerRadius}"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #15000000"/>
        </Style>

        <Style Selector="Button.ActionPrimary">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.Inspect">
            <Setter Property="Background" Value="{DynamicResource ThemeAlertRedBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.Inspect:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style Selector="Button.Inspect:focus">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.Inspect:focus-visible">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeDataGridRowHoverBrush}"/>
        </Style>
        <Style Selector="Button.MenuItem:focus">
            <Setter Property="Background" Value="{DynamicResource ThemeDataGridRowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>
        <Style Selector="Button.MenuItem:focus-visible">
            <Setter Property="Background" Value="{DynamicResource ThemeDataGridRowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>

        <Style Selector="Button.MenuItemSub">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.MenuItemSub:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeDataGridRowHoverBrush}"/>
        </Style>
        <Style Selector="Button.MenuItemSub:focus">
            <Setter Property="Background" Value="{DynamicResource ThemeDataGridRowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>
        <Style Selector="Button.MenuItemSub:focus-visible">
            <Setter Property="Background" Value="{DynamicResource ThemeDataGridRowHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- TOP NAVIGATION HEADER -->
        <Border Grid.Row="0" 
                Background="{DynamicResource ThemeHeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource ThemeCardBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Hamburger Menu Button & App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleMenuCommand}"
                            ToolTip.Tip="Menu (Shift+Space)"
                            MinHeight="36"
                            Padding="8,0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="☰" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding ShowKeyboardHints}"
                                    Background="{DynamicResource ThemeBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Shift+Space" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LehmiaeJonossa" 
                                   FontSize="17" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                        <TextBlock Text="Azure Service Bus Diagnostic Dashboard" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Active Namespace Selector (Kept in header bar) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}">
                        <Run TextDecorations="Underline">N</Run><Run>amespace:</Run>
                    </TextBlock>

                    <ComboBox x:Name="NamespaceComboBox"
                              ItemsSource="{Binding Namespaces}" 
                              SelectedItem="{Binding SelectedNamespace}"
                              Width="340"
                              Height="34"
                              CornerRadius="6"
                              ToolTip.Tip="{Binding SelectedNamespace}"/>

                    <Button Command="{Binding ShowAddNamespaceCommand}" 
                            ToolTip.Tip="Add new namespace (Alt+A)"
                            Padding="8,4"
                            CornerRadius="6"
                            FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="+" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding ShowKeyboardHints}"
                                    Background="{DynamicResource ThemeBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="3,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Alt+A" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DiscoverNamespacesCommand}" 
                            ToolTip.Tip="Auto-discover Service Bus namespaces (Alt+D)"
                            Padding="8,4"
                            CornerRadius="6"
                            FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="↻" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding ShowKeyboardHints}"
                                    Background="{DynamicResource ThemeBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="3,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Alt+D" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Controls: Timer, Refresh -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <!-- Auto-refresh pill -->
                    <Button Command="{Binding ToggleAutoRefreshCommand}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            ToolTip.Tip="Click to Pause / Resume auto refresh (Alt+T)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⏱️" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AutoRefreshCountdownText}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding ShowKeyboardHints}"
                                    Background="{DynamicResource ThemeBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="3,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Alt+T" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Classes="ActionPrimary" 
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Refresh (F5, ⌘R, or Alt+R)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🔄" Foreground="{DynamicResource ThemeAccentForegroundBrush}"/>
                            <TextBlock Foreground="{DynamicResource ThemeAccentForegroundBrush}">
                                <Run TextDecorations="Underline">R</Run><Run>efresh</Run>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ADD NAMESPACE INLINE POPUP/BAR -->
        <Border Grid.Row="0" 
                IsVisible="{Binding IsAddingNamespace}"
                Background="{DynamicResource ThemeHeaderBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeAccentBrush}"
                BorderThickness="0,0,0,2"
                Padding="24,12"
                ZIndex="10">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="Add Service Bus Namespace:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="NewNamespaceTextBox"
                         Text="{Binding NewNamespaceInput}" 
                         Watermark="e.g. my-servicebus.servicebus.windows.net" 
                         Width="380"
                         Height="34"/>
                <Button Classes="ActionPrimary"
                        Command="{Binding ConfirmAddNamespaceCommand}"
                        ToolTip.Tip="Save (Enter or Alt+S)">
                    <TextBlock>
                        <Run TextDecorations="Underline">S</Run><Run>ave</Run>
                    </TextBlock>
                </Button>
                <Button Command="{Binding CancelAddNamespaceCommand}"
                        ToolTip.Tip="Cancel (Esc or Alt+C)">
                    <TextBlock>
                        <Run TextDecorations="Underline">C</Run><Run>ancel</Run>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT AREA WITH HAMBURGER MENU DRAWER -->
        <SplitView Grid.Row="1"
                   IsPaneOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                   DisplayMode="Overlay"
                   PanePlacement="Left"
                   OpenPaneLength="340"
                   PaneBackground="{DynamicResource ThemeCardBackgroundBrush}">
            <SplitView.Pane>
                <!-- SIDEBAR MENU DRAWER -->
                <Border Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer Padding="20,16">
                        <StackPanel Spacing="16">
                            <!-- Drawer Header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,0">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Menu" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock Text="Shortcut: Shift+Space" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource ThemeTextMutedBrush}" 
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        x:Name="MenuCloseButton"
                                        Command="{Binding CloseMenuCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,4"
                                        Cursor="Hand"
                                        ToolTip.Tip="Close Menu (Shift+Space or Esc)">
                                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                </Button>
                            </Grid>

                            <Separator Height="1" Background="{DynamicResource ThemeCardBorderBrush}" Margin="0,-4,0,0"/>

                            <!-- STACK OF MENU ITEMS -->
                            <StackPanel Spacing="4">
                                <!-- 1. ACCOUNT MENU ITEM -->
                                <Button x:Name="MenuAccountButton"
                                        Classes="MenuItem" 
                                        Command="{Binding OpenAccountDialogCommand}"
                                        ToolTip.Tip="Open Account &amp; Authentication dialog (A or Alt+A)">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="👤" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                                <Run TextDecorations="Underline">A</Run><Run>ccount</Run>
                                            </TextBlock>
                                            <TextBlock Text="{Binding AccountIdentity, FallbackValue='Azure Account Details'}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource ThemeTextMutedBrush}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="..." FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <!-- 2. NAMESPACES MENU ITEM -->
                                <Button x:Name="MenuNamespacesButton"
                                        Classes="MenuItem" 
                                        Command="{Binding OpenNamespacesDialogCommand}"
                                        ToolTip.Tip="Manage Service Bus namespaces (N or Alt+N)">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="☁️" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                                <Run TextDecorations="Underline">N</Run><Run>amespaces</Run>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SelectedNamespace, FallbackValue='Manage configured namespaces'}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource ThemeTextMutedBrush}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="..." FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <!-- 3. DEMO TOGGLE MENU ITEM -->
                                <Button x:Name="MenuDemoButton"
                                        Classes="MenuItem" 
                                        Command="{Binding ToggleDemoModeCommand}"
                                        ToolTip.Tip="Toggle between live Azure data and offline mock metrics (Alt+D or Space)">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="🧪" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                                <Run TextDecorations="Underline">D</Run><Run>emo Mode</Run>
                                            </TextBlock>
                                            <TextBlock Text="Offline mock metrics" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" 
                                                CornerRadius="10" 
                                                Padding="8,3" 
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ThemeBackgroundBrush}"
                                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding DemoModeStatusText}" 
                                                       FontSize="11" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource ThemeAccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- 3. THEME SUB MENU ITEM -->
                                <Button x:Name="MenuThemeButton"
                                        Classes="MenuItem"
                                        Command="{Binding ToggleThemeSubMenuCommand}"
                                        ToolTip.Tip="Select application theme (Alt+T)">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="🎨" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                                <Run TextDecorations="Underline">T</Run><Run>heme</Run>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SelectedTheme, StringFormat='Active: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="›" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <!-- THEME SUB MENU (FOLLOWS THE LOOKS OF THE REST OF THE MENU) -->
                                <Border IsVisible="{Binding IsThemeSubMenuOpen}"
                                        Background="{DynamicResource ThemeBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="8,2,8,4"
                                        Padding="4">
                                    <StackPanel Spacing="3">
                                        <Button x:Name="MenuThemeLightButton"
                                                Classes="MenuItemSub" 
                                                Command="{Binding SetThemeCommand}" 
                                                CommandParameter="{x:Static models:AppTheme.Light}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="☀️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="Medium" VerticalAlignment="Center">
                                                    <Run TextDecorations="Underline">L</Run><Run>ight</Run>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="✓" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccessGreenBrush}" IsVisible="{Binding IsLightThemeSelected}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="MenuThemeDarkButton"
                                                Classes="MenuItemSub" 
                                                Command="{Binding SetThemeCommand}" 
                                                CommandParameter="{x:Static models:AppTheme.Dark}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="🌙" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="Medium" VerticalAlignment="Center">
                                                    <Run>Dar</Run><Run TextDecorations="Underline">k</Run>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="✓" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccessGreenBrush}" IsVisible="{Binding IsDarkThemeSelected}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="MenuThemeLegoButton"
                                                Classes="MenuItemSub" 
                                                Command="{Binding SetThemeCommand}" 
                                                CommandParameter="{x:Static models:AppTheme.Lego}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="🧱" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="Medium" VerticalAlignment="Center">
                                                    <Run>Le</Run><Run TextDecorations="Underline">g</Run><Run>o</Run>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="✓" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccessGreenBrush}" IsVisible="{Binding IsLegoThemeSelected}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="MenuThemeBarbieButton"
                                                Classes="MenuItemSub" 
                                                Command="{Binding SetThemeCommand}" 
                                                CommandParameter="{x:Static models:AppTheme.Barbie}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="💖" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="Medium" VerticalAlignment="Center">
                                                    <Run TextDecorations="Underline">B</Run><Run>arbie</Run>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="✓" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccessGreenBrush}" IsVisible="{Binding IsBarbieThemeSelected}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 4. KEYBOARD HINTS TOGGLE MENU ITEM -->
                                <Button x:Name="MenuKeyboardHintsButton"
                                        Classes="MenuItem" 
                                        Command="{Binding ToggleKeyboardHintsCommand}"
                                        ToolTip.Tip="Toggle keyboard shortcut hints and footers (Alt+K or Space)">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="⌨️" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                                                <Run TextDecorations="Underline">K</Run><Run>eyboard Hints</Run>
                                            </TextBlock>
                                            <TextBlock Text="Show footers &amp; badges" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" 
                                                CornerRadius="10" 
                                                Padding="8,3" 
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ThemeBackgroundBrush}"
                                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding KeyboardHintsStatusText}" 
                                                       FontSize="11" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource ThemeAccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Separator Height="1" Background="{DynamicResource ThemeCardBorderBrush}" Margin="0,4"/>

                            <!-- KEYBOARD SHORTCUTS REFERENCE (KEPT VISIBLE BELOW MENU ITEMS) -->
                            <StackPanel Spacing="8" Margin="4,0">
                                <TextBlock Text="KEYBOARD SHORTCUTS" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           LetterSpacing="0.8"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="Toggle Menu" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Shift+Space" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="Refresh Metrics" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="F5 / ⌘R / Alt+R" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="Inspect Hotlist 1-9" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="⌘/Ctrl + 1-9" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="Navigate Hotlist" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="↑ / ↓" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="Search Entities" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Alt + S" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="Focus Namespace" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Alt + N" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="Manage Namespaces" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Menu &gt; N" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="Toggle Hints" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Alt + K" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="Close Menu" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Esc" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </SplitView.Pane>
            <SplitView.Content>
                <!-- MAIN CONTENT AREA -->
                <ScrollViewer Padding="24,20">
            <StackPanel Spacing="22">
                <!-- HERO KPI CARDS -->
                <Grid ColumnDefinitions="*,*,*,*">
                    <!-- KPI 1: DEAD LETTERS DETECTED -->
                    <Border Grid.Column="0" Margin="0,0,10,0" 
                            Classes="Card"
                            Background="{DynamicResource ThemeAlertRedBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeAlertRedBorderBrush}"
                            BorderThickness="2"
                            Padding="20,16">
                        <StackPanel Spacing="8">
                            <!-- Lego stud decoration if active -->
                            <Rectangle Height="{DynamicResource ThemeCardHeaderAccentHeight}" 
                                       Fill="{DynamicResource ThemeCardHeaderAccentBrush}" 
                                       Margin="-20,-16,-20,6"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding TotalDeadLetterCount, StringFormat='{}{0:N0}'}" 
                                           FontSize="32" 
                                           FontWeight="ExtraBold" 
                                           Foreground="{DynamicResource ThemeAlertRedBrush}"/>
                                <TextBlock Grid.Column="1" 
                                           Text="🚨" 
                                           FontSize="26" 
                                           VerticalAlignment="Top"/>
                            </Grid>
                            <TextBlock Text="Dead Letters Detected" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeAlertRedBrush}"/>
                            <TextBlock Text="Total dead-lettered messages across all queues and topics" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: ENTITIES REQUIRING ATTENTION -->
                    <Border Grid.Column="1" Margin="5,0,5,0" 
                            Classes="Card"
                            Background="{DynamicResource ThemeWarningAmberBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeWarningAmberBorderBrush}"
                            Padding="20,16">
                        <StackPanel Spacing="8">
                            <Rectangle Height="{DynamicResource ThemeCardHeaderAccentHeight}" 
                                       Fill="{DynamicResource ThemeCardHeaderAccentBrush}" 
                                       Margin="-20,-16,-20,6"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding EntitiesRequiringAttentionCount}" 
                                           FontSize="32" 
                                           FontWeight="ExtraBold" 
                                           Foreground="{DynamicResource ThemeWarningAmberBrush}"/>
                                <TextBlock Grid.Column="1" 
                                           Text="⚠️" 
                                           FontSize="24" 
                                           VerticalAlignment="Top"/>
                            </Grid>
                            <TextBlock Text="Entities in Alert" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeWarningAmberBrush}"/>
                            <TextBlock Text="Queues and subscriptions with dead letters (> 0)" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: HEALTHY ENTITIES -->
                    <Border Grid.Column="2" Margin="5,0,5,0" 
                            Classes="Card"
                            Background="{DynamicResource ThemeSuccessGreenBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeSuccessGreenBorderBrush}"
                            Padding="20,16">
                        <StackPanel Spacing="8">
                            <Rectangle Height="{DynamicResource ThemeCardHeaderAccentHeight}" 
                                       Fill="{DynamicResource ThemeCardHeaderAccentBrush}" 
                                       Margin="-20,-16,-20,6"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding HealthyEntitiesCount}" 
                                           FontSize="32" 
                                           FontWeight="ExtraBold" 
                                           Foreground="{DynamicResource ThemeSuccessGreenBrush}"/>
                                <TextBlock Grid.Column="1" 
                                           Text="✅" 
                                           FontSize="24" 
                                           VerticalAlignment="Top"/>
                            </Grid>
                            <TextBlock Text="Healthy Entities" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeSuccessGreenBrush}"/>
                            <TextBlock Text="Queues and subscriptions with zero dead letters" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: TOTAL IN-FLIGHT MESSAGES -->
                    <Border Grid.Column="3" Margin="10,0,0,0" 
                            Classes="Card"
                            Padding="20,16">
                        <StackPanel Spacing="8">
                            <Rectangle Height="{DynamicResource ThemeCardHeaderAccentHeight}" 
                                       Fill="{DynamicResource ThemeCardHeaderAccentBrush}" 
                                       Margin="-20,-16,-20,6"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding TotalActiveMessagesCount, StringFormat='{}{0:N0}'}" 
                                           FontSize="32" 
                                           FontWeight="ExtraBold" 
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" 
                                           Text="📨" 
                                           FontSize="24" 
                                           VerticalAlignment="Top"/>
                            </Grid>
                            <TextBlock Text="Total Active Messages" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                            <TextBlock Text="Live in-flight messages processing normally" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- "NEEDS IMMEDIATE ATTENTION" HOTLIST -->
                <Border Classes="Card" 
                        Background="{DynamicResource ThemeCardBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeAlertRedBorderBrush}"
                        BorderThickness="2"
                        Padding="22">
                    <StackPanel Spacing="16">
                        <!-- Stud accent row -->
                        <Rectangle Height="{DynamicResource ThemeCardHeaderAccentHeight}" 
                                   Fill="{DynamicResource ThemeCardHeaderAccentBrush}" 
                                   Margin="-22,-22,-22,4"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                <Border Background="{DynamicResource ThemeAlertRedBrush}" 
                                        Width="26" Height="26" 
                                        CornerRadius="13" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="!" 
                                               Foreground="#FFFFFF" 
                                               FontWeight="ExtraBold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Needs Immediate Attention" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource ThemeAlertRedBrush}"/>
                                    <TextBlock Text="The following queues and topic subscriptions contain dead-lettered messages:" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                <!-- Clean / No Issues: Non-warning Green Theme (matches 'All clean!' box) -->
                                <Border IsVisible="{Binding !HasDeadLettersDetected}" 
                                        Background="{DynamicResource ThemeSuccessGreenBackgroundBrush}" 
                                        BorderBrush="{DynamicResource ThemeSuccessGreenBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="10,4">
                                    <TextBlock Text="{Binding EntitiesRequiringAttentionCount, StringFormat='{}{0} Issues Pending'}" 
                                               FontWeight="Bold" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeSuccessGreenBrush}"/>
                                </Border>

                                <!-- Issues Detected: Warning Red Theme -->
                                <Border IsVisible="{Binding HasDeadLettersDetected}" 
                                        Background="{DynamicResource ThemeAlertRedBackgroundBrush}" 
                                        BorderBrush="{DynamicResource ThemeAlertRedBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="10,4">
                                    <TextBlock Text="{Binding EntitiesRequiringAttentionCount, StringFormat='{}{0} Issues Pending'}" 
                                               FontWeight="Bold" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource ThemeAlertRedBrush}"/>
                                </Border>
                            </Panel>
                        </Grid>

                        <!-- If No Issues -->
                        <Border IsVisible="{Binding !HasDeadLettersDetected}" 
                                Background="{DynamicResource ThemeSuccessGreenBackgroundBrush}" 
                                BorderBrush="{DynamicResource ThemeSuccessGreenBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="20">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <TextBlock Text="🎉" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="All clean! No dead-lettered messages found in this namespace." 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource ThemeSuccessGreenBrush}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Hotlist Items -->
                        <ItemsControl x:Name="HotlistControl"
                                      ItemsSource="{Binding HotlistEntities}" 
                                      IsVisible="{Binding HasDeadLettersDetected}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:ServiceBusEntityMetric">
                                    <Border Background="{DynamicResource ThemeAlertRedBackgroundBrush}"
                                            BorderBrush="{DynamicResource ThemeAlertRedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,0,0,10"
                                            Padding="16,12">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                            <!-- Figure Badge (1 to 9) -->
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource ThemeCardBackgroundBrush}" 
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    MinWidth="28" Height="28"
                                                    Padding="6,0"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding HotlistShortcutTip}">
                                                <TextBlock Text="{Binding FormattedHotlistIndex}" 
                                                           FontSize="12" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Kind Badge -->
                                            <Border Grid.Column="1" 
                                                    Background="{DynamicResource ThemeCardBackgroundBrush}" 
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="8,3" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindDisplay}" 
                                                           FontSize="11" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            </Border>

                                            <!-- Entity Name -->
                                            <StackPanel Grid.Column="2" Margin="14,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" 
                                                           FontSize="14" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding FormattedLastActivity, StringFormat='Last active: {0}'}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                            </StackPanel>

                                            <!-- Active Messages Pill (Green if 0, Yellow/Amber if > 0) -->
                                            <Panel Grid.Column="3" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <!-- Zero Active Messages: Green Pill -->
                                                <Border IsVisible="{Binding !HasActiveMessages}"
                                                        Background="{DynamicResource ThemeSuccessGreenBrush}" 
                                                        CornerRadius="6" 
                                                        Padding="12,6" 
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="🟢" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="0 Active" 
                                                                   Foreground="#FFFFFF" 
                                                                   FontWeight="ExtraBold" 
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Greater than Zero Active Messages: Yellow/Amber Pill -->
                                                <Border IsVisible="{Binding HasActiveMessages}"
                                                        Background="{DynamicResource ThemeWarningAmberBrush}" 
                                                        CornerRadius="6" 
                                                        Padding="12,6" 
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="📨" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FormattedActiveCount, StringFormat='{}{0} Active'}" 
                                                                   Foreground="#FFFFFF" 
                                                                   FontWeight="ExtraBold" 
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Panel>

                                            <!-- Combined DLQ Inspect Button with Message Count -->
                                            <Button Grid.Column="4" 
                                                    Classes="Inspect" 
                                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).InspectEntityCommand}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTip.Tip="{Binding HotlistInspectButtonToolTip}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="🚨" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormattedDeadLetterCount, StringFormat='Inspect DLQ ({0})'}" 
                                                               Foreground="#FFFFFF" 
                                                               FontWeight="ExtraBold" 
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Row Number to the right of the button -->
                                            <Border Grid.Column="5" 
                                                    Background="{DynamicResource ThemeCardBackgroundBrush}" 
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    MinWidth="28" Height="28"
                                                    Padding="6,0"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding HotlistShortcutTip}">
                                                <TextBlock Text="{Binding FormattedHotlistIndex}" 
                                                           FontSize="12" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ALL ENTITIES EXPLORER TABLE -->
                <Border Classes="Card" Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Stud accent row -->
                        <Rectangle Height="{DynamicResource ThemeCardHeaderAccentHeight}" 
                                   Fill="{DynamicResource ThemeCardHeaderAccentBrush}" 
                                   Margin="-20,-20,-20,4"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="All Entities" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FilteredEntities.Count, StringFormat='({0} items)'}" 
                                           FontSize="13" 
                                           Foreground="{DynamicResource ThemeTextMutedBrush}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Filter & Search Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <!-- Search Input -->
                                <TextBox x:Name="SearchTextBox"
                                         Text="{Binding SearchText}" 
                                         Watermark="Search queues and topics (Alt+S)..." 
                                         ToolTip.Tip="Search entities (Alt+S)"
                                         Width="260" 
                                         Height="32" 
                                         CornerRadius="6"/>

                                <!-- Filter Buttons -->
                                <ComboBox x:Name="FilterComboBox"
                                          ItemsSource="{Binding AvailableFilters}" 
                                          SelectedItem="{Binding SelectedFilter}"
                                          ToolTip.Tip="Filter entities (Alt+F)"
                                          Width="150" 
                                          Height="32" 
                                          CornerRadius="6"/>
                            </StackPanel>
                        </Grid>

                        <!-- DataGrid -->
                        <DataGrid x:Name="EntitiesDataGrid"
                                  ItemsSource="{Binding FilteredEntities}" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal" 
                                  HeadersVisibility="Column" 
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  RowBackground="Transparent"
                                  MinHeight="250">
                            <DataGrid.Columns>
                                <!-- Kind -->
                                <DataGridTemplateColumn Header="Type" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:ServiceBusEntityMetric">
                                            <Border Background="{DynamicResource ThemeCardBorderBrush}" 
                                                    CornerRadius="4" 
                                                    Padding="6,2" 
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Center" 
                                                    Margin="8,0">
                                                <TextBlock Text="{Binding KindDisplay}" 
                                                           FontSize="11" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Name -->
                                <DataGridTextColumn Header="Entity Name" 
                                                    Binding="{Binding DisplayName}" 
                                                    Width="*" 
                                                    FontWeight="SemiBold"/>

                                <!-- Dead Letters (Highlighted) -->
                                <DataGridTemplateColumn Header="Dead Letters" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:ServiceBusEntityMetric">
                                            <Panel VerticalAlignment="Center" Margin="8,0">
                                                <Border IsVisible="{Binding HasDeadLetters}" 
                                                        Background="{DynamicResource ThemeAlertRedBrush}" 
                                                        CornerRadius="4" 
                                                        Padding="8,2" 
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding FormattedDeadLetterCount}" 
                                                               Foreground="#FFFFFF" 
                                                               FontWeight="Bold" 
                                                               FontSize="12"/>
                                                </Border>
                                                <TextBlock IsVisible="{Binding !HasDeadLetters}" 
                                                           Text="0" 
                                                           Foreground="{DynamicResource ThemeTextMutedBrush}" 
                                                           FontSize="12"/>
                                            </Panel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Active Count (Pill) -->
                                <DataGridTemplateColumn Header="Active Messages" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:ServiceBusEntityMetric">
                                            <Panel VerticalAlignment="Center" Margin="8,0">
                                                <!-- > 0 active: Amber/Yellow pill -->
                                                <Border IsVisible="{Binding HasActiveMessages}" 
                                                        Background="{DynamicResource ThemeWarningAmberBrush}" 
                                                        CornerRadius="4" 
                                                        Padding="8,2" 
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding FormattedActiveCount}" 
                                                               Foreground="#FFFFFF" 
                                                               FontWeight="Bold" 
                                                               FontSize="12"/>
                                                </Border>
                                                <!-- 0 active: Green pill -->
                                                <Border IsVisible="{Binding !HasActiveMessages}" 
                                                        Background="{DynamicResource ThemeSuccessGreenBrush}" 
                                                        CornerRadius="4" 
                                                        Padding="8,2" 
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="0" 
                                                               Foreground="#FFFFFF" 
                                                               FontWeight="Bold" 
                                                               FontSize="12"/>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Size -->
                                <DataGridTextColumn Header="Size" 
                                                    Binding="{Binding FormattedSize}" 
                                                    Width="100"/>

                                <!-- Last Activity -->
                                <DataGridTextColumn Header="Last Activity" 
                                                    Binding="{Binding FormattedLastActivity}" 
                                                    Width="120"/>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:ServiceBusEntityMetric">
                                            <Button Classes="Inspect" 
                                                    Content="Inspect" 
                                                    FontSize="11" 
                                                    Padding="10,4" 
                                                    Margin="4" 
                                                    IsVisible="{Binding HasDeadLetters}"
                                                    Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).InspectEntityCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- STATUS BAR -->
                <Border Background="Transparent" Padding="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding StatusMessage}" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                        <TextBlock Grid.Column="1" 
                                   Text="Azure Service Bus DLQ Monitor v1.0" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
            </SplitView.Content>
        </SplitView>

        <!-- KEYBOARD SHORTCUTS FOOTER (TOGGLEABLE) -->
        <Border Grid.Row="2" 
                IsVisible="{Binding ShowKeyboardHints}"
                Background="{DynamicResource ThemeHeaderBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="⌨️" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="Shortcuts:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Shift+Space: Menu  •  F5 / ⌘R / Alt+R: Refresh  •  ⌘1-9: Inspect Hotlist  •  ↑/↓: Navigate Hotlist  •  Alt+S: Search  •  Alt+N: Namespace  •  Esc: Close" 
                               FontSize="11" 
                               Foreground="{DynamicResource ThemeTextMutedBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" 
                           Text="Toggle footer in Menu (Shift+Space > Alt+K)" 
                           FontSize="10" 
                           Foreground="{DynamicResource ThemeTextMutedBrush}" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
