<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AzureDeadLetterMonitor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="460"
        x:Class="AzureDeadLetterMonitor.Views.AccountDialogWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Azure Account &amp; Authentication"
        Width="480" Height="460"
        MinWidth="420" MinHeight="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThemeCardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ThemeCardCornerRadius}"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #15000000"/>
        </Style>
        <Style Selector="Button.ActionPrimary">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,20">
            <Border Grid.Column="0" Width="40" Height="40" 
                    Background="{DynamicResource ThemeHeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10" 
                    Margin="0,0,14,0">
                <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Azure Account &amp; Authentication" 
                           FontSize="17" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                <TextBlock Text="Configure authentication mode and view connection identity" 
                           FontSize="12" 
                           Foreground="{DynamicResource ThemeTextMutedBrush}"/>
            </StackPanel>
        </Grid>

        <!-- CONTENT BODY -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- Status & Identity Card -->
                <Border Classes="Card" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="CONNECTION STATUS" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                   LetterSpacing="0.8"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding AuthStatus}" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThemeSuccessGreenBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Background="{DynamicResource ThemeBackgroundBrush}"
                                CornerRadius="6"
                                Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Identity: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccountIdentity, FallbackValue='Not available'}" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Namespace: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNamespace, FallbackValue='None'}" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Auth Mode Selector Card -->
                <Border Classes="Card" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="AUTHENTICATION METHOD" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                   LetterSpacing="0.8"/>

                        <ComboBox ItemsSource="{Binding AvailableAuthModes}" 
                                  SelectedItem="{Binding SelectedAuthMode}"
                                  HorizontalAlignment="Stretch"
                                  Height="36"
                                  CornerRadius="6"/>

                        <TextBlock Text="DefaultAzureCredential resolves Azure CLI credentials locally and Managed Identity when deployed to Azure." 
                                   FontSize="11" 
                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Press Esc to close" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" 
                        Content="Done" 
                        Classes="ActionPrimary" 
                        Click="OnCloseClicked"/>
            </Grid>
        </Border>
    </Grid>
</Window>
